APP_NAME=CelebrateMi
APP_ENV=local
APP_KEY=
APP_DEBUG=true

# Every canonical URL, og:url, sitemap entry and emailed link is built from
# this. In production it must be exactly https://celebratemi.com — no trailing
# slash, no www, https not http. Getting it wrong points search engines at a
# domain that does not serve the site.
APP_URL=http://localhost

# Search Console and Bing Webmaster verification tokens, once the domain is
# claimed. Both are optional; the meta tags are only emitted when set.
SEO_GOOGLE_VERIFICATION=
SEO_BING_VERIFICATION=

# A new account's currency comes from the country its signup IP resolves to
# (config/currency.php country_map). This is the country assumed when the
# address cannot be placed — a private IP in development, a failed lookup.
# Clear it to fall through to the base currency instead.
CURRENCY_FALLBACK_COUNTRY=NG

# Development only: stands in for 127.0.0.1 so the real ipinfo lookup runs
# locally. Any public address will do.
LOCATION_DEV_IP=

# URL scheme of the React Native app in celebrateMobile/. Must match "scheme"
# in that project's app.json — /payments/bridge redirects payment gateways back
# into the app with it.
MOBILE_SCHEME=celebratemi

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=celebrate
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
