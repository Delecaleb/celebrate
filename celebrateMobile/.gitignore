# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
# .env holds EXPO_PUBLIC_API_URL, which differs per machine (each developer's
# emulator host or LAN IP), so it stays local. Copy .env.example instead.
.env
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android
