# Where the Laravel app is reachable FROM THE DEVICE.
#
# "localhost" means the phone or the simulator itself, not your machine, so it
# only works in the iOS simulator. Pick the line that matches how you are
# running:
#
#   iOS simulator      http://127.0.0.1:8000
#   Android emulator   http://10.0.2.2:8000
#   Physical device    http://<your-LAN-IP>:8000   (e.g. http://192.168.1.24:8000)
#   Deployed           https://celebratemi.example.com
#
# Serve Laravel on all interfaces so the device can reach it:
#   php artisan serve --host=0.0.0.0 --port=8000
#
# Do NOT include /api/v1 — the client appends it.
EXPO_PUBLIC_API_URL=http://10.0.2.2:8000
