{
  "expo": {
    "name": "CelebrateMi",
    "slug": "celebratemi",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "celebratemi",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#7c3aed"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.celebratemi.app",
      "infoPlist": {
        "NSCameraUsageDescription": "CelebrateMi uses the camera so you can record a video wish for a celebration.",
        "NSMicrophoneUsageDescription": "CelebrateMi uses the microphone to record the audio of your video wish.",
        "NSPhotoLibraryUsageDescription": "CelebrateMi needs your photo library so you can add cover photos and picture wishes."
      }
    },
    "android": {
      "package": "com.celebratemi.app",
      "usesCleartextTraffic": true,
      "adaptiveIcon": {
        "backgroundColor": "#7c3aed",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "celebratemi"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      "expo-video",
      "expo-sharing",
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "CelebrateMi needs your photo library so you can add cover photos and picture wishes.",
          "cameraPermission": "CelebrateMi uses the camera so you can record a video wish for a celebration."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "CelebrateMi uses the camera so you can record a video wish for a celebration.",
          "microphonePermission": "CelebrateMi uses the microphone to record the audio of your video wish."
        }
      ]
    ],
    "extra": {
      "//": "Override at build time with EXPO_PUBLIC_API_URL. See src/api/config.ts.",
      "apiUrl": "http://192.168.1.166:8000",
      "router": {},
      "eas": {
        "projectId": "a883b665-15c9-41a3-9510-ab35a238c96c"
      }
    }
  }
}
