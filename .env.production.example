# ─────────────────────────────────────────────────────────────────────────────
# CelebrateMi — production environment
#
# Copy to .env on the server and fill in every value marked CHANGE-ME. Nothing
# here is optional: each one either takes the site down, leaks data, or stops
# money moving if it is wrong.
#
# After editing:  php artisan config:cache && php artisan queue:restart
#
# Gateway keys, mail, ipinfo and the currency list can also be managed from
# Admin → Settings / Currencies once the site is up, and what is set there wins
# over this file. Fill them in here anyway: this is the floor the site boots on
# before anyone has signed in, and any field left blank in the panel falls back
# to it. See DEPLOY.md §9.
# ─────────────────────────────────────────────────────────────────────────────

APP_NAME=CelebrateMi
APP_ENV=production

# php artisan key:generate --force  (do this once; changing it later makes every
# encrypted value and session unreadable)
APP_KEY=CHANGE-ME

# Never true in production: a stack trace here shows the world your database
# password and API keys.
APP_DEBUG=false

# Exactly this, with https and no trailing slash. Canonical URLs, og:url,
# sitemap entries and every emailed link are built from it.
APP_URL=https://celebratemi.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# ── Logging ──────────────────────────────────────────────────────────────────
# daily keeps 14 files instead of one that grows for ever. Never 'debug' here —
# it writes request payloads, which include personal data.
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL=null

# ── Database ─────────────────────────────────────────────────────────────────
# A user scoped to this one database. Never root, never an empty password.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=celebrate
DB_USERNAME=CHANGE-ME
DB_PASSWORD=CHANGE-ME

# ── Sessions and cookies ─────────────────────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
# Encrypt session payloads at rest, and refuse to send the cookie over plain
# HTTP. Both are safe once the site is fully on https.
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_DOMAIN=.celebratemi.com

# ── Queue, cache, uploads ────────────────────────────────────────────────────
# The queue must have a worker running or no email is ever sent — see DEPLOY.md.
QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=public
BROADCAST_CONNECTION=log

# ── Mail ─────────────────────────────────────────────────────────────────────
# 'log' means nothing is delivered — password resets included. Use a real SMTP
# provider and a from-address on a domain you have set SPF/DKIM for.
MAIL_MAILER=smtp
MAIL_HOST=CHANGE-ME
MAIL_PORT=587
MAIL_USERNAME=CHANGE-ME
MAIL_PASSWORD=CHANGE-ME
MAIL_SCHEME=tls
MAIL_FROM_ADDRESS=hello@celebratemi.com
MAIL_FROM_NAME="${APP_NAME}"

# ── Payments ─────────────────────────────────────────────────────────────────
# Live keys, not test. Without these nothing can be charged, verified or paid
# out, and bank-account verification silently falls back to manual entry.
# Rotating a key later is a panel job (Admin → Settings → Payments), not a
# redeploy — what is saved there overrides these.
PAYSTACK_SECRET_KEY=CHANGE-ME
PAYSTACK_PUBLIC_KEY=CHANGE-ME

STRIPE_SECRET_KEY=CHANGE-ME
STRIPE_PUBLISHABLE_KEY=CHANGE-ME
# From the Stripe dashboard's webhook endpoint page — this is NOT the API key.
STRIPE_WEBHOOK_SECRET=CHANGE-ME

# Register both webhook endpoints in the dashboards:
#   Paystack → https://celebratemi.com/webhooks/paystack   (charge.success)
#   Stripe   → https://celebratemi.com/webhooks/stripe     (checkout.session.completed)

# ── Location and currency ────────────────────────────────────────────────────
# A new account's currency is decided once, at signup, from the country its IP
# resolves to. Nigeria gets NGN and therefore Paystack; everywhere unmapped
# gets the base currency and Stripe.
#
# The currency list itself lives in the database and is edited at
# Admin → Currencies — which currencies exist, their symbols, fallback rates
# and the countries that map to each. config/currency.php is only the seed and
# the fallback for a fresh install.
IPINFO_TOKEN=CHANGE-ME

# The country to assume when an address cannot be placed: a private IP, a
# failed lookup, a crawler. Without it every such signup became a USD account.
# Clear it to fall through to the base currency instead.
CURRENCY_FALLBACK_COUNTRY=NG

# Development only — stands in for 127.0.0.1 so the real lookup can be
# exercised locally. Leave empty in production.
LOCATION_DEV_IP=

# ── Search engines ───────────────────────────────────────────────────────────
SEO_GOOGLE_VERIFICATION=
SEO_BING_VERIFICATION=

# ── Legal ────────────────────────────────────────────────────────────────────
# These are printed as fact on /terms and /privacy. A placeholder in public is
# worse than no page at all.
LEGAL_ENTITY="CHANGE-ME Limited"
LEGAL_RC_NUMBER=CHANGE-ME
LEGAL_ADDRESS="CHANGE-ME, Lagos, Nigeria"
LEGAL_EMAIL=hello@celebratemi.com
LEGAL_PRIVACY_EMAIL=privacy@celebratemi.com
LEGAL_JURISDICTION="the Federal Republic of Nigeria"
LEGAL_EFFECTIVE="CHANGE-ME 2026"
# Must match what the pricing page says.
LEGAL_GIFT_FEE=5

# ── Mobile ───────────────────────────────────────────────────────────────────
MOBILE_SCHEME=celebratemi
